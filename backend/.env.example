# ── Anthropic ──────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenWeatherMap ─────────────────────────────────────────
# Free tier at: https://openweathermap.org/api
# Sign up → API keys → copy your key
OPENWEATHER_API_KEY=...

# ── Supabase ───────────────────────────────────────────────
# From: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ── Server ─────────────────────────────────────────────────
PORT=3001

# ── Security ───────────────────────────────────────────────
# Random string used to protect your API endpoints
# Generate one at: https://generate-secret.vercel.app/32
API_SECRET=your-random-secret-here
